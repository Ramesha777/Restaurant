rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Publicly readable menu images only under /menu_images/{imageId}
    match /menu_images/{imageId} {
      allow read: if true;
      // Allow create with validations: authenticated, image MIME, size under 5MB
      allow create: if request.auth != null
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      // Updates reserved for admins and validated like create; deletes still require admin
      allow update: if request.auth != null && request.auth.token.admin == true
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // User-specific private storage (e.g., user uploads)
    match /user_uploads/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|application/pdf');
      // Allow update by owner or admin only if incoming file meets size/type checks; delete preserved for owner/admin
      allow update: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true)
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|application/pdf');
      allow delete: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
    }

    // Deny anything else by default
  }
}